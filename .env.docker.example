# ─── Variables pour docker-compose ───────────────────────────────────────────
# Copiez ce fichier en .env (à la racine) et remplissez les valeurs

# Port exposé sur le host (ex: 8090)
PORT=8090

# PostgreSQL
POSTGRES_DB=garminia
POSTGRES_USER=garminia
POSTGRES_PASSWORD=changeme_strong_password

# Mode démo (true = pas besoin de Garmin ni d'IA)
VITE_DEMO_MODE=false

# URL du backend vue par le navigateur (laisser vide = même host, port 80)
VITE_API_URL=
